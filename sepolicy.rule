# ThermalGuard SELinux rules (minimal)
# Do NOT set SELinux to permissive.
#
# Magisk/KSU/APatch already run module scripts in a privileged domain.
# Broad or device-specific types (e.g. sysfs_thermal) can be missing on
# Samsung/OEM kernels and may break boot. Keep rules minimal.

# Allow root manager to read module status under /data/adb/thermalguard
allow magisk system_data_file:dir r_dir_perms;
allow magisk system_data_file:file r_file_perms;

# KernelSU / APatch managers (best-effort; ignore if type absent on device)
# allow ksud system_data_file:dir r_dir_perms;
# allow ksud system_data_file:file r_file_perms;
